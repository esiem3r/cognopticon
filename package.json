{
  "name": "cosmopticon",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A local spatial observatory for project dossiers, relationships, and agent mission briefs.",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "eslint .",
    "test": "vitest run src/lib/domain.test.ts src/lib/canvas.test.ts src/lib/validateData.test.ts",
    "test:e2e": "playwright test",
    "validate:data": "node scripts/validate-data.mjs",
    "scan": "node scripts/scan-workspace.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "vite": "^7.0.0",
    "typescript": "^5.8.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "lucide-react": "^0.468.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.50.0",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "typescript-eslint": "^8.18.2",
    "vitest": "^2.1.8"
  }
}
