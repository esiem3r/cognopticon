{
  "name": "cognopticon",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "A local spatial observatory for project dossiers, relationships, and agent mission briefs.",
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "build:pages": "tsc -b && vite build --mode pages --base=/cognopticon/ --outDir dist-pages",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "eslint .",
    "audit:ux": "node scripts/ux-audit.mjs",
    "audit:deps": "npm audit --audit-level=moderate",
    "test": "vitest run src/lib/domain.test.ts src/lib/missionPacket.test.ts src/intelligence/missionCompiler.test.ts src/lib/canvas.test.ts src/lib/validateData.test.ts src/lib/workspacePipeline.test.ts src/model/model.test.ts src/field/fieldModel.test.ts src/agency/agencyKernel.test.ts src/agency/actionBus.test.ts src/agency/agentAdapters.test.ts src/agency/agentRuntime.test.ts src/services/daemonClient.test.ts src/components/missionDrawerState.test.ts src/components/cognition/CognitionRail.test.ts daemon/src/index.test.js",
    "test:daemon": "vitest run daemon/src/index.test.js",
    "test:e2e": "playwright test",
    "validate:data": "node scripts/validate-data.mjs",
    "validate:release": "node scripts/validate-release-hygiene.mjs",
    "validate:community": "node scripts/validate-community-health.mjs",
    "validate:github": "node scripts/validate-github-repo.mjs",
    "validate:package": "node scripts/validate-package-artifact.mjs",
    "validate:payload": "node scripts/validate-release-payload.mjs",
    "validate:local": "node scripts/validate-local-pipeline.mjs",
    "validate:lifecycle": "node scripts/validate-lifecycle-packet.mjs",
    "validate:daemon": "node scripts/validate-local-daemon.mjs",
    "validate:daemon-config": "node scripts/validate-local-daemon-config.mjs",
    "validate:pages": "node scripts/validate-pages-demo.mjs",
    "scan": "node scripts/scan-workspace.mjs --profile-output",
    "analyze": "node scripts/analyze-workspace.mjs",
    "enrich:packets": "node scripts/enrichment-packets.mjs",
    "lifecycle:packet": "node scripts/lifecycle-loop.mjs",
    "release:checkpoint": "node scripts/release-checkpoint.mjs",
    "sanitize:demo": "node scripts/sanitize-demo-workspace.mjs",
    "local:init": "node scripts/local-init.mjs",
    "local": "npm run build && node daemon/src/index.js",
    "check": "node scripts/run-check.mjs"
  },
  "dependencies": {
    "@types/three": "^0.184.1",
    "@vitejs/plugin-react": "^5.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.184.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.50.0",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "typescript-eslint": "^8.18.2",
    "vitest": "^4.1.7"
  }
}
